__pycache__/
*.pyc
*.pyo
.env
*.db

# Raw market data — regenerated via `python data/download_data.py`
data/raw/*.parquet

# Processed feature parquets — regenerated via `python data/compute_features.py`
data/processed/*.parquet

# Generated chart outputs
outputs/charts/*.png

# RL runtime state — regenerated as the system accumulates trades
database/rl_*.npz
database/rl_*.pkl
database/rl_*.json

# Research datasets — regenerated via `python research/channel_regime/data.py`
data/research/*.parquet

# Indian market data — regenerated via `python research/channel_regime/data_in.py`
data/research_in/*.parquet
data/research_1h/
