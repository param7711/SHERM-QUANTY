outputs/charts/*.png

# RL runtime state — regenerated as the system accumulates trades
database/rl_*.npz
database/rl_*.pkl
database/rl_*.json

# SMA18 trend-forex research: FX parquet cache + generated outputs
research/sma18_trend_forex/data/*.parquet
research/sma18_trend_forex/outputs/*.csv
research/sma18_trend_forex/outputs/*.json
